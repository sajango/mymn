# MT5 Elliott Wave Auto-Trading System - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# CORE SETTINGS
# ============================================

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# MetaTrader 5
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
MT5_SYMBOL=XAUUSD

# Risk Management
RISK_PERCENT=1.5
MAX_POSITION_SIZE=0.1

# Position Sizing Mode
# Set USE_FIXED_LOTS=true to use fixed lot size instead of risk-based calculation
USE_FIXED_LOTS=false
FIXED_LOT_SIZE=0.03

# Trading Mode (true = paper trading, false = live trading)
PAPER_TRADING=true

# Claude CLI timeout in seconds
CLAUDE_TIMEOUT=300

# ============================================
# SLIPPAGE SETTINGS
# ============================================

# Maximum allowed slippage in points
MAX_SLIPPAGE=20

# Expected slippage for calculations (pips)
EXPECTED_SLIPPAGE_PIPS=1.0

# ============================================
# SESSION CONFIDENCE ADJUSTMENTS
# ============================================
# These values are added to base confidence during specific sessions

SESSION_CONFIDENCE_OVERLAP=10
SESSION_CONFIDENCE_LONDON=5
SESSION_CONFIDENCE_NY=5
SESSION_CONFIDENCE_ASIAN=-15
SESSION_CONFIDENCE_OFFHOURS=-20

# ============================================
# SPREAD SETTINGS
# ============================================

# Maximum spread allowed to enter trade (pips)
MAX_SPREAD_PIPS=4.0

# ============================================
# TRAILING STOP SETTINGS
# ============================================

# ATR multiplier for trailing stop distance
TRAIL_ATR_MULTIPLIER=1.5

# Pips above entry to move SL to breakeven
BREAKEVEN_BUFFER_PIPS=5

# ============================================
# NEWS FILTER SETTINGS
# ============================================

# Minutes before high-impact news to avoid trading
NEWS_BLACKOUT_BEFORE_MINS=30

# Minutes after high-impact news to avoid trading
NEWS_BLACKOUT_AFTER_MINS=15

# ============================================
# CONFIDENCE THRESHOLDS
# ============================================

# Minimum confidence to generate signal (below = silent skip)
CONFIDENCE_THRESHOLD=50

# Confidence for full position size
CONFIDENCE_FULL_POSITION=75

# Confidence for half position size (between THRESHOLD and FULL)
CONFIDENCE_HALF_POSITION=60

# ============================================
# SIGNAL FILTERING PARAMETERS
# ============================================

# Cooldown period before allowing direction change (minutes)
DIRECTION_CHANGE_COOLDOWN_MINUTES=30

# Minimum confidence required for direction reversal
DIRECTION_CHANGE_MIN_CONFIDENCE=65

# Time window to detect rapid flip-flop pattern (minutes)
RAPID_FLIP_THRESHOLD_MINUTES=30

# ============================================
# MARKET REGIME PARAMETERS
# ============================================

# ADX threshold for weak trend (10-30)
REGIME_TREND_THRESHOLD_WEAK=20

# ADX threshold for strong trend (30-50)
REGIME_TREND_THRESHOLD_STRONG=35

# Volatility percentile thresholds
REGIME_VOLATILITY_LOW=20
REGIME_VOLATILITY_HIGH=80
REGIME_VOLATILITY_EXTREME=95

# ============================================
# SIGNAL SETTINGS
# ============================================

# Signal expiration timeout in seconds (5 minutes default)
SIGNAL_TIMEOUT=300

# ============================================
# AUTO-TRADING SETTINGS
# ============================================

# Enable automatic trade execution (true = auto-execute, false = manual only)
AUTO_TRADE_ENABLED=false

# Minimum confidence for auto-execution (signals below this go to manual)
AUTO_TRADE_CONFIDENCE=75

# Maximum auto-trades per day (safety limit)
AUTO_TRADE_MAX_DAILY=5

# ============================================
# RISK GUARD SETTINGS
# ============================================

# Maximum concurrent open positions
MAX_CONCURRENT_POSITIONS=2

# Maximum total lot exposure across all positions
MAX_TOTAL_LOTS=0.2

# Maximum account risk percentage
MAX_ACCOUNT_RISK_PERCENT=3.0

# Policy for handling opposite direction signals: reject, close_first, hedge
OPPOSITE_POSITION_POLICY=close_first

# Minutes to block duplicate signals
DUPLICATE_COOLDOWN_MINUTES=15

# ============================================
# DATABASE SETTINGS
# ============================================

# SQLite database path (relative to project root)
DATABASE_PATH=data/trades.db

# ============================================
# LOGGING
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path (relative to project root)
LOG_PATH=logs/trading.log

# ============================================
# DRAWDOWN MANAGEMENT
# ============================================

# Enable drawdown-based position size adjustment
ENABLE_DRAWDOWN_CHECK=true

# ============================================
# PORTFOLIO RISK MANAGEMENT
# ============================================

# Maximum portfolio heat (total exposure as % of account)
MAX_PORTFOLIO_HEAT=6.0

# Portfolio heat warning level (%)
PORTFOLIO_HEAT_WARNING=4.0

# Maximum risk with correlations included (%)
MAX_CORRELATED_RISK=8.0

# Performance targets for risk adjustment
WIN_RATE_TARGET=40.0
PROFIT_FACTOR_TARGET=1.5

# Maximum consecutive losses before risk reduction
MAX_CONSECUTIVE_LOSSES_RISK=3

# Daily loss limit (% of account)
DAILY_LOSS_LIMIT_PERCENT=3.0

# ============================================
# VOLATILITY MANAGEMENT
# ============================================

# Enable volatility-based position sizing
ENABLE_VOLATILITY_SIZING=true

# Volatility thresholds (ATR-based)
VOLATILITY_LOW_THRESHOLD=0.7
VOLATILITY_HIGH_THRESHOLD=1.5
VOLATILITY_EXTREME_THRESHOLD=2.0

# ============================================
# MARKET REGIME SETTINGS
# ============================================

# Enable regime-based confidence adjustments
ENABLE_REGIME_ADJUSTMENT=true

# Regime confidence modifiers
REGIME_STRONG_TREND_BONUS=10
REGIME_TREND_BONUS=5
REGIME_RANGING_PENALTY=-10
REGIME_HIGH_VOL_PENALTY=-15

# ============================================
# MULTI-TP EXIT SETTINGS
# ============================================

# Default exit strategy: FIXED_RATIO, ATR_BASED, FIBONACCI, ADAPTIVE
DEFAULT_EXIT_STRATEGY=ADAPTIVE

# Time stop hours for stale positions
DEFAULT_TIME_STOP_HOURS=24

# Partial exit percentages
TP1_EXIT_PERCENT=50
TP2_EXIT_PERCENT=30
TP3_EXIT_PERCENT=20

# ============================================
# OBSERVER SETTINGS (Event-Driven Market Observer)
# ============================================

# Enable event-driven market observer (volatility spike + key level proximity)
OBSERVER_ENABLED=true

# Cooldown between triggered analyses (seconds) - prevents spam
OBSERVER_COOLDOWN_SECONDS=900

# ATR ratio threshold for spike detection (1.8 = 80% above baseline)
OBSERVER_SPIKE_THRESHOLD=1.8

# ATR multiplier for key level proximity detection
OBSERVER_KEY_LEVEL_ATR_FACTOR=1.0

# Interval to update ATR baseline cache (seconds) - hourly default
OBSERVER_BASELINE_UPDATE_SECONDS=3600
