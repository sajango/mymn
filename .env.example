# MT5 Elliott Wave Auto-Trading System - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# CORE SETTINGS
# ============================================

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# MetaTrader 5
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
MT5_SYMBOL=XAUUSD

# Risk Management
RISK_PERCENT=1.5
MAX_POSITION_SIZE=0.1

# Position Sizing Mode
# Set USE_FIXED_LOTS=true to use fixed lot size instead of risk-based calculation
USE_FIXED_LOTS=false
FIXED_LOT_SIZE=0.03

# Trading Mode (true = paper trading, false = live trading)
PAPER_TRADING=true

# Claude CLI timeout in seconds
CLAUDE_TIMEOUT=300

# ============================================
# SLIPPAGE SETTINGS
# ============================================

# Maximum allowed slippage in points
MAX_SLIPPAGE=20

# Expected slippage for calculations (pips)
EXPECTED_SLIPPAGE_PIPS=1.0

# ============================================
# SESSION CONFIDENCE ADJUSTMENTS
# ============================================
# These values are added to base confidence during specific sessions

SESSION_CONFIDENCE_OVERLAP=10
SESSION_CONFIDENCE_LONDON=5
SESSION_CONFIDENCE_NY=5
SESSION_CONFIDENCE_ASIAN=-15
SESSION_CONFIDENCE_OFFHOURS=-20

# ============================================
# SPREAD SETTINGS
# ============================================

# Maximum spread allowed to enter trade (pips)
MAX_SPREAD_PIPS=4.0

# ============================================
# TRAILING STOP SETTINGS
# ============================================

# ATR multiplier for trailing stop distance
TRAIL_ATR_MULTIPLIER=1.5

# Pips above entry to move SL to breakeven
BREAKEVEN_BUFFER_PIPS=5

# ============================================
# NEWS FILTER SETTINGS
# ============================================

# Minutes before high-impact news to avoid trading
NEWS_BLACKOUT_BEFORE_MINS=30

# Minutes after high-impact news to avoid trading
NEWS_BLACKOUT_AFTER_MINS=15

# ============================================
# CONFIDENCE THRESHOLDS
# ============================================

# Minimum confidence to generate signal (below = silent skip)
CONFIDENCE_THRESHOLD=60

# Confidence for full position size
CONFIDENCE_FULL_POSITION=75

# Confidence for half position size (between THRESHOLD and FULL)
CONFIDENCE_HALF_POSITION=60

# ============================================
# SIGNAL SETTINGS
# ============================================

# Signal expiration timeout in seconds (5 minutes default)
SIGNAL_TIMEOUT=300

# ============================================
# AUTO-TRADING SETTINGS
# ============================================

# Enable automatic trade execution (true = auto-execute, false = manual only)
AUTO_TRADE_ENABLED=false

# Minimum confidence for auto-execution (signals below this go to manual)
AUTO_TRADE_CONFIDENCE=75

# Maximum auto-trades per day (safety limit)
AUTO_TRADE_MAX_DAILY=5

# ============================================
# DATABASE SETTINGS
# ============================================

# SQLite database path (relative to project root)
DATABASE_PATH=data/trades.db

# ============================================
# LOGGING
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path (relative to project root)
LOG_PATH=logs/trading.log
