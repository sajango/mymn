            "reason": "Data feed quality issues"
        })
    
    return {
        "has_emergency": len(emergency_conditions) > 0,
        "conditions": emergency_conditions,
        "recommended_action": emergency_conditions[0]["action"] if emergency_conditions else "CONTINUE"
    }
