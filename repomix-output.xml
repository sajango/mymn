            ),
            direction_change_min_confidence=getattr(
                settings, "direction_change_min_confidence", 75
            ),
            rapid_flip_threshold_minutes=getattr(
                settings, "rapid_flip_threshold_minutes", 30
            ),
        )
    return _signal_filter
