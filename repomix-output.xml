        details.append(f"Strong EMA alignment: {ema_position['trend']}")
    elif ema_position["trend"].startswith("weak"):
        score += 5
        details.append("Weak but aligned EMA structure")
    
    # MACD confirmation  
    if macd["histogram_direction"] == wave_position.split("_")[0]:
