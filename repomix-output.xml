                    strategy = ExitStrategy(strategy_str)
                    perf = ExitPerformance(strategy=strategy, **perf_data)
                    self.strategy_performance[strategy] = perf
                    
                logger.info("Loaded exit strategy performance history")
        except Exception as e:
